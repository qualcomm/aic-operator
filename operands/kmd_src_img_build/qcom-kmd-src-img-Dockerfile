# Extract the source rootdir from the platform SDK. This stage is discarded, so the
# extraction toolchain is never shipped and the host needs only docker to extract.
FROM registry.access.redhat.com/ubi9/ubi AS extractor
ARG ARCHITECTURE=x86_64
# unzip reads the SDK archive; rpm2cpio (from rpm, already in the base image) and
# cpio unpack the packages. rpm2cpio decompresses the payload through librpm, so
# no standalone decompressor is needed even though el9 payloads are zstd.
RUN --mount=type=cache,target=/var/cache/dnf \
    yum install -y unzip rpm cpio
# COPY --link with a file resets the parent directory's permissions to 755, so
# use a dedicated working directory rather than one we care about.
WORKDIR /build

COPY --link qaic-platform-sdk-*.zip .
# Unzip in its own layer so editing make_src_root.sh below does not re-extract the
# SDK. unzip exits non-zero if the pattern matches nothing, so a layout change in
# the archive fails the build here rather than producing an empty source tree.
RUN unzip -q -j qaic-platform-sdk-*.zip \
        "qaic-platform-sdk-*/${ARCHITECTURE}/rpm/rpm/*" -d psdk

COPY --link make_src_root.sh .
RUN bash make_src_root.sh psdk/qaic-fw-*.rpm psdk/qaic-kmd-*.noarch.rpm


FROM registry.access.redhat.com/ubi9/ubi-micro
ARG VERSION=none
COPY --from=extractor /build/src_rootdir /
LABEL name="cloud_ai_openshift_operator" \
      maintainer="Qualcomm Technologies, Inc." \
      vendor="Qualcomm Technologies, Inc." \
      version="${VERSION}" \
      release="${VERSION}" \
      summary="Openshift Operator to orchestrate the Qualcomm AIC containers" \
      description="The Openshift Operator enables the Qualcomm® Cloud AI series of hardware \
on OpenShift clusters by automating the configuration and installation of their \
Linux device drivers and its Kubernetes Device Plugin."

RUN mkdir /licenses

# Include license and location information
LABEL org.opencontainers.image.source=https://github.com/qualcomm/cloud-ai-containers
COPY --chmod=755 motd.sh /etc
COPY CONTAINER_LICENSE.txt /usr/share/doc
RUN ln -s /usr/share/doc/CONTAINER_LICENSE.txt / && \
    ln -s /usr/share/doc/CONTAINER_LICENSE.txt /root && \
    cp /usr/share/doc/CONTAINER_LICENSE.txt /licenses && \
# Different systems use different system wide non-login shell config files
    if [ -e /etc/bash.bashrc ]; then \
        echo '[ ! -z "$TERM" -a -r /etc/motd.sh ] && /etc/motd.sh' >> /etc/bash.bashrc ; \
    elif [ -e /etc/bashrc ]; then \
        echo '[ ! -z "$TERM" -a -r /etc/motd.sh ] && /etc/motd.sh' >> /etc/bashrc ; \
    else \
        echo "Unable to find system bashrc" ; \
        exit 1 ; \
    fi
#set user to non-root. UBI images define 65534 as user "nobody"
USER 65534:65534
